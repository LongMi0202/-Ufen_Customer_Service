# Copy to .env. Compose overrides infrastructure, service URLs and authentication.
DATABASE_URL=postgresql+psycopg://customer_service:change-me@127.0.0.1:5432/customer_service
REDIS_URL=redis://127.0.0.1:6379/0
AI_SERVICE_URL=http://127.0.0.1:8002
AI_TIMEOUT_SECONDS=180
AI_WORKER_LEASE_SECONDS=240
JWT_SECRET=replace-with-the-same-secret-as-the-root-env
INTERNAL_SERVICE_TOKEN=replace-with-the-same-token-as-the-root-env
