# Copy to .env. Compose overrides database, service URLs and shared authentication.
# Set your model key locally; actual .env files are excluded from Git.
LLM_PROVIDER=openai_compatible
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
AGENT_MODE=multi
CUSTOMER_SERVICE_BASE_URL=http://127.0.0.1:8000
MULTI_TOKEN_BUDGET=60000
MULTI_CONCURRENCY=2
MULTI_TASK_TIMEOUT_SECONDS=45
AI_DATABASE_URL=postgresql+psycopg://customer_service:change-me@127.0.0.1:5432/ai_customer_service
ECOMMERCE_BASE_URL=http://127.0.0.1:8001/api/v1
JWT_SECRET=replace-with-the-same-secret-as-the-root-env
INTERNAL_SERVICE_TOKEN=replace-with-the-same-token-as-the-root-env
