graph TD
    U["user_001：修改ORDER_A_001收货地址"] --> C["会话、Turn、Worker与根上下文准备"]
    C --> R["路由识别：SINGLE，订单改址意图"]
    R --> A["订单Agent只读调用get_order"]
    A --> B["商城API验证归属并返回当前订单"]
    B --> K{"当前状态允许直接改址？"}
    K -->|"否"| N["说明当前不能直接改址，不声称成功"]
    N --> NV["公共回复校验、Turn复查并发布说明"]
    K -->|"是"| S["订单Agent提出EDIT_ADDRESS与订单编号"]
    S --> V["Harness校验白名单及成功订单证据"]
    V --> P["根结果准备 / Turn复核 / 确认可发布"]
    P --> C1["前端展示：前往修改地址卡片"]
    C1 --> H["用户点击卡片，仅打开页面"]
    H --> F["前端重新读取订单与当前地址"]
    F --> E["用户编辑地址，点击保存地址"]
    E --> W["前端携带令牌与幂等键调用PATCH接口"]
    W --> D["业务后端：鉴权、参数与幂等检查、锁订单"]
    D --> K2{"最新订单状态仍允许改址？"}
    K2 -->|"是"| TX["事务内保存地址并增加订单版本"]
    K2 -->|"否"| ER["拒绝修改，返回状态冲突"]
    TX --> OK["业务页面显示成功并刷新订单详情"]
    ER --> FAIL["业务页面显示实际失败原因"]
    classDef program fill:#EAF3FF,stroke:#2A62B8,color:#14335F;
    classDef model fill:#E8F6F0,stroke:#198266,color:#105543;
    classDef business fill:#FFF3DB,stroke:#B87313,color:#744500;
    classDef human fill:#F5ECFE,stroke:#8154AD,color:#543273;
    classDef rejected fill:#FCECEC,stroke:#C84848,color:#822F2F;
    class C,V,P,C1,F,W,K,K2,NV program;
    class R,A,S model;
    class B,D,TX,OK business;
    class U,H,E human;
    class N,ER,FAIL rejected;
